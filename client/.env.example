# ==============================================================================
# SmartRoute Client (Vite) Environment Configuration Template (v6)
# All VITE_* variables are embedded into the public client bundle at build time.
# Never place server-only secrets (JWT_SECRET, GEOAPIFY_SERVER_API_KEY, SMTP_PASS) here.
# ==============================================================================

# API Base URL:
# - Single-Origin / Vite dev proxy: use /api/v1
# - Split-Origin production build (e.g. Vercel SPA + Render API): use https://api.yourdomain.com/api/v1
VITE_API_URL=/api/v1

# Socket.IO Server URL:
# - Leave blank to use relative '/' in Single-Origin / Vite dev proxy, or auto-derive origin from VITE_API_URL in Split-Origin
# - Set explicit https://api.yourdomain.com only if the Socket.IO host differs from VITE_API_URL
VITE_SOCKET_URL=

# Map Tile Provider & Client Tile Key (leave VITE_GEOAPIFY_TILE_API_KEY blank for OpenStreetMap tile fallback)
VITE_MAP_PROVIDER=geoapify
VITE_GEOAPIFY_TILE_API_KEY=your_geoapify_client_tile_key_here

# Google OAuth Web Client ID (must list your SPA origin under Authorized JavaScript Origins in Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# POD OTP Feature Flag
VITE_ENABLE_POD_OTP=false
