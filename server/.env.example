# ==============================================================================
# SmartRoute Server Environment Configuration Template (v6)
# Copy this file to server/.env for server-only local development.
# Never commit server/.env or real production secrets to version control.
# ==============================================================================

# Server Runtime & Hardening (server/src/config/env.js)
# Aligns with client/vite.config.ts proxy, Dockerfile, and docker-compose.yml
PORT=5004
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smartroute

# JWT Security Secrets:
# Generate unique >=32-character secrets in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_random_32plus_char_secret
JWT_REFRESH_SECRET=replace_with_random_32plus_char_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Single-Origin Hosting:
# - CLIENT_ORIGIN supports comma-separated production origins when SERVE_CLIENT=false
# - Set SERVE_CLIENT=true for Single-Origin Express SPA + API hosting
CLIENT_ORIGIN=http://localhost:5173
SERVE_CLIENT=false

# Proxy & Transport Security:
# - TRUST_PROXY defaults to 1 in NODE_ENV=production; specify integer hop count or false (never boolean true)
# - Set FORCE_HTTPS_CSP=true behind HTTPS termination (Render/Cloudflare); keep false for local HTTP Docker Compose
TRUST_PROXY=false
FORCE_HTTPS_CSP=false

# Mapping & Geocoding (server/src/config/env.js, geoapify.service.js, googleMapsService.js)
MAP_PROVIDER=geoapify
GEOAPIFY_SERVER_API_KEY=YOUR_GEOAPIFY_SERVER_KEY
GEOAPIFY_API_KEY=
GOOGLE_MAPS_API_KEY=

# Google OAuth & Out-of-Band OTP Integrations
GOOGLE_CLIENT_ID=
SMTP_SERVICE=gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartRoute Operations <no-reply@smartroute.local>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# POD OTP Feature Flag
ENABLE_POD_OTP=false

# Initial Production Admin Bootstrap (npm --prefix server run seed:admin)
# ADMIN_PASSWORD must be >= 10 non-whitespace characters; never use weak or placeholder passwords
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=SmartRoute Admin
