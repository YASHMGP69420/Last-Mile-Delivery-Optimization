# ==============================================================================
# SmartRoute Unified Environment Configuration Template
# Copy this file to .env in local development. Never commit .env with real secrets.
# ==============================================================================

# Server Runtime Configuration
PORT=5004
NODE_ENV=development

# Database Configuration (MongoDB v6+)
MONGODB_URI=mongodb://127.0.0.1:27017/smartroute

# JWT Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=your_secure_random_jwt_secret_minimum_32_chars_here
JWT_REFRESH_SECRET=your_secure_random_refresh_secret_minimum_32_chars_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin (Client URL)
CLIENT_ORIGIN=http://localhost:5174

# Map & Geocoding Integrations
MAP_PROVIDER=geoapify
GEOAPIFY_API_KEY=your_geoapify_api_key_here
GEOAPIFY_SERVER_API_KEY=your_geoapify_api_key_here

# Frontend Environment Variables (Vite prefixed)
VITE_API_URL=http://localhost:5004/api/v1
VITE_MAP_PROVIDER=geoapify
VITE_GEOAPIFY_TILE_API_KEY=your_geoapify_client_tile_key_here
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Google OAuth & OTP Verification (Server)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartRoute Operations <no-reply@smartroute.local>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
