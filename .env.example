# ==============================================================================
# SmartRoute Unified Environment Configuration Template (v6)
# Copy this file to .env for local development or Docker Compose.
# Never commit real .env files or production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime & Hardening (server/src/config/env.js)
# ------------------------------------------------------------------------------
# Aligns with client/vite.config.ts proxy, Dockerfile, and docker-compose.yml
PORT=5004
NODE_ENV=development

# MongoDB v6+ connection URI (for Docker Compose, docker-compose.yml defaults to mongodb://mongo:27017/smartroute)
MONGODB_URI=mongodb://127.0.0.1:27017/smartroute

# JWT Security Secrets (production requires >= 32 chars and distinct values; generate via: openssl rand -hex 32)
JWT_SECRET=replace_with_random_32plus_char_secret
JWT_REFRESH_SECRET=replace_with_random_32plus_char_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated in production when SERVE_CLIENT=false, e.g. https://app.yourdomain.com)
CLIENT_ORIGIN=http://localhost:5173

# Single-Origin vs Split-Origin Hosting:
# - Set SERVE_CLIENT=true for Single-Origin Express SPA + API hosting (Docker Compose / Render Blueprint)
# - Keep SERVE_CLIENT=false for Vite dev server or Split-Origin hosting (Vercel SPA + Render API)
SERVE_CLIENT=false

# Express trust proxy hop count:
# - Defaults to 1 when NODE_ENV=production; specify integer hop count (e.g. 1) or false (never boolean true)
TRUST_PROXY=false

# Set true behind HTTPS termination (Render, Cloudflare, TLS load balancer); keep false for local HTTP Docker Compose
FORCE_HTTPS_CSP=false

# ------------------------------------------------------------------------------
# 2. Mapping & Geocoding (server/src/config/env.js, geoapify.service.js, googleMapsService.js)
# ------------------------------------------------------------------------------
MAP_PROVIDER=geoapify
GEOAPIFY_SERVER_API_KEY=YOUR_GEOAPIFY_SERVER_KEY
# Optional legacy fallback when GEOAPIFY_SERVER_API_KEY is unset
GEOAPIFY_API_KEY=
# Optional legacy Google Distance Matrix fallback key
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 3. Frontend Vite Build/Dev Variables (client/src/, docker-compose.yml)
# ------------------------------------------------------------------------------
# Single-Origin vs Split-Origin API URL:
# - /api/v1 for Vite dev proxy and Single-Origin Docker/Render builds
# - Set https://api.yourdomain.com/api/v1 for Split-Origin Vercel builds
VITE_API_URL=/api/v1

# Socket.IO URL:
# - Leave blank to use relative '/' in Single-Origin/Vite dev proxy or auto-derive origin from VITE_API_URL in Split-Origin
# - Set explicit https://api.yourdomain.com only if the Socket.IO host differs from VITE_API_URL
VITE_SOCKET_URL=

VITE_MAP_PROVIDER=geoapify
# Leave blank to fall back to public OpenStreetMap tiles
VITE_GEOAPIFY_TILE_API_KEY=your_geoapify_client_tile_key_here
# Must match GOOGLE_CLIENT_ID and have Authorized JavaScript Origins configured in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# POD OTP Feature Flag
VITE_ENABLE_POD_OTP=false

# ------------------------------------------------------------------------------
# 4. Google OAuth & Out-of-Band OTP Integrations (server/src/config/env.js)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartRoute Operations <no-reply@smartroute.local>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# POD OTP Feature Flag
ENABLE_POD_OTP=false

# ------------------------------------------------------------------------------
# 5. Docker Compose Host Port (docker-compose.yml)
# ------------------------------------------------------------------------------
HTTP_PORT=80

# ------------------------------------------------------------------------------
# 6. Initial Production Admin Bootstrap (server/src/scripts/bootstrapAdmin.js)
# ------------------------------------------------------------------------------
# Required by: npm --prefix server run seed:admin
ADMIN_EMAIL=
# Required >= 10 non-whitespace characters; never set weak or placeholder passwords
ADMIN_PASSWORD=
ADMIN_NAME=SmartRoute Admin

# ------------------------------------------------------------------------------
# 7. Post-Deploy Smoke Test CLI Fallbacks (scripts/smoke-test.js)
# ------------------------------------------------------------------------------
SMOKE_API_URL=
SMOKE_CLIENT_URL=
SMOKE_ORIGIN=
SMOKE_RETRIES=10
SMOKE_DELAY_MS=1000
SMOKE_EMAIL=
SMOKE_PASSWORD=
